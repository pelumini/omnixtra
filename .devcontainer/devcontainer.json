{
  "name": "OmniXtra",
  "dockerComposeFile": [
    "../docker-compose.yml",
    "docker-compose.devcontainer.yml"
  ],
  "service": "api-dev",
  "workspaceFolder": "/workspaces/omnixtra",
  "shutdownAction": "stopCompose",
  "postCreateCommand": "cd api && uv sync --dev && uv run alembic upgrade head",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-python.mypy-type-checker",
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss"
      ]
    }
  }
}
