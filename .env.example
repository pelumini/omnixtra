APP_ENV=local
APP_NAME=OmniXtra
APP_BASE_DOMAIN=localhost
JWT_SECRET_KEY=local-dev-secret-change-me-32-bytes-minimum
JWT_ISSUER=omnixtra-api
ACCESS_TOKEN_MINUTES=15
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://omnixtra_app:omnixtra_app_password@postgres:5432/omnixtra
