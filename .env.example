REDIS_URL=redis://redis:6379/0
POSTGRES_PORT=15432
REDIS_PORT=16379
OMNIXTRA_APP_PASSWORD=omnixtra_app_password
OMNIXTRA_MIGRATIONS_PASSWORD=omnixtra_migrations_password
OMNIXTRA_SUPERADMIN_PASSWORD=omnixtra_superadmin_password
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_PROVIDER=auto
AI_PROVIDER_TIMEOUT_SECONDS=30
AI_TUTOR_REQUESTS_PER_MINUTE=20
AI_MONTHLY_TOKEN_BUDGET=100000
AI_MONTHLY_TOKEN_WARNING_PERCENT=80
AI_TUTOR_ESTIMATED_TOKENS_PER_REQUEST=1500
AI_TUTOR_FEATURE_TOKEN_LIMIT=4000
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=OmniXtra <no-reply@omnixtra.local>
